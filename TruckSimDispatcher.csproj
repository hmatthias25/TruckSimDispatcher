<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TruckSimDispatcher</AssemblyName>
    <RootNamespace>TruckSimDispatcher</RootNamespace>
    <AssemblyTitle>TruckSim Dispatcher</AssemblyTitle>
    <Product>TruckSim Dispatcher</Product>
    <Version>1.0.0</Version>

    <!-- Portable single-file publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- The UI is embedded in the assembly and there is no IIS host, so none of the
         web-project publish scaffolding applies. Suppressing it keeps the published
         output to exactly one file. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- UI is embedded in the assembly so the published exe is truly one file -->
  <ItemGroup>
    <EmbeddedResource Include="ui\index.html" LogicalName="ui/index.html" />
    <EmbeddedResource Include="ui\styles.css" LogicalName="ui/styles.css" />
    <EmbeddedResource Include="ui\app.js" LogicalName="ui/app.js" />
    <!-- Real US city coordinates, so distances are measured rather than guessed. MIT, attributed
         in the file header and in the credits. ~800 KB, nothing against a 52 MB exe. -->
    <EmbeddedResource Include="data-embedded\us-cities.txt" LogicalName="data/us-cities.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="ui\**" />
    <None Remove="ui\**" />
    <!-- Career files are runtime state, never build input. -->
    <Content Remove="data\**" />
    <None Remove="data\**" />
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
    <!-- Nothing outside the app is build input. The Web SDK globs **/*.json as Content and copies it to
         the publish folder, which quietly swept the manual's Chrome profiles - thousands of extension
         manifests, some stamped 1979 - into the release output and broke the zip on a timestamp Zip
         cannot represent. A single-file publish should produce a single file. -->
    <Content Remove="docs\**" />
    <None Remove="docs\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="publish-ship\**" />
    <None Remove="publish-ship\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.40.0" />
  </ItemGroup>

</Project>
