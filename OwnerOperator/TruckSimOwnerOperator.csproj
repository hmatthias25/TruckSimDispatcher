<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TruckSim Owner-Operator: the second app over the shared Core. Its own exe, its own career file and its own
       manual; see docs/owner-operator-plan.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TruckSimOwnerOperator</AssemblyName>
    <RootNamespace>TruckSimOwnerOperator</RootNamespace>
    <AssemblyTitle>TruckSim Owner-Operator</AssemblyTitle>
    <Product>TruckSim Owner-Operator</Product>
    <Version>0.9.0</Version>

    <!-- Portable single-file publish, the same as the company-driver app. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\index.html" LogicalName="ui/index.html" />
    <EmbeddedResource Include="ui\styles.css" LogicalName="ui/styles.css" />
    <EmbeddedResource Include="ui\app.js" LogicalName="ui/app.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="ui\**;oo-data\**;publish\**" />
    <None Remove="ui\**;oo-data\**;publish\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TruckSim.Core.csproj" />
  </ItemGroup>

</Project>
